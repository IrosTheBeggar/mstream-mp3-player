 "animation": {
  "cycle": "two beats; parity 0 = even beat, 1 = odd beat; phi in [0,1) within a beat; u = parity + phi",
  "global_offset_screen_px": {
   "bob": "idle only: 1.5 sin(2 pi t / 2.6 s) screen px on every layer but the legs (the feet stay on the ground)",
   "hop": "dy = -9 * 4a(1-a), a = max(0, (phi-0.12)/0.88): on the ground (squashed) for phi < 0.12, a ballistic hop peaking 9 px at phi 0.56, landing hard at phi 1",
   "side_step": "dx = 6 * (from + (to-from) * smoothstep(0.12, 0.92, phi)); even beat travels left->right (-6 -> +6), odd beat right->left, so the crab is at a side extreme on every beat and slides sideways in the air"
  },
  "body_frame": {
   "body_squash": "phi < 0.12 (contact)",
   "body": "0.12 <= phi < 0.84",
   "body_stretch": "phi >= 0.84 (anticipation, reaching for the ground)"
  },
  "legs_frame": {
   "legs_splay": "phi < 0.12",
   "legs_air": "0.3 <= phi < 0.7",
   "legs": "otherwise"
  },
  "claws": "left claw punches on even beats, right on odd. lift = 1 + round(8 * pulse(v)), v = beats from its own beat; pulse rises as ((v+0.22)/0.22)^2 over the last 0.22 beat (anticipation), is 1 on the beat, falls with smoothstep over 0.7 beat. The beat claw is claw_closed (snap) for phi < 0.16, else claw_open. Arms: the 4x1 arm tile (red, not the orange of the eye stalks) repeated from under the pincer to body top + 8 (hidden behind the body).",
  "snap_fx": "fx_snap (white and gold spark) over the beat claw for phi < 0.12: centred on the claw, 6 native px above its top.",
  "eyes": "eyes offset = round((body offset 0.12 beat ago - body offset now) / 3), clamped to +-2 native px: the stalks trail the hop and the side-step. Frame: eyes_happy (^ ^) during the squash of odd beats only, so the face alternates wide-eyed / squint each beat; eyes_look for phi 0.2-0.8 with the pupils toward the travel (flipped on odd beats); eyes otherwise.",
  "shadow": "contact shadow (palette index 13) drawn first, over the ground line, rows groundY+2 .. groundY+4: 66 px wide on the ground, 2 px narrower per 2 px of hop, centred under the crab.",
  "mouth": "baked into the body frames: smile (body), open grin (squash), \"o\" (stretch)",
  "draw_order": "shadow, legs, right arm+claw, left arm+claw (flipped), eyes, body, fx_snap",
  "idle (confidence < 0.3)": "body frame only; bob = 1.5 sin(2 pi t / 2.6 s) breathing (feet stay planted); claws tucked low (lift -3), each twitches up 1 px and snaps for 0.25 s on its own 2.9 s / 3.3 s cycle; eyes glance on a 5.3 s cycle (eyes_look, flipped for left, and +-1 px) and sink 1 px on the out-breath; blink (eyes_happy) 0.16 s every 3.7 s; palette_idle (half-desaturated, dimmed).",
  "blend": "w eases 0<->1 over ~0.4 s like the stick figure: offsets and lifts lerp idle->dance, frames switch at w = 0.5, palette lerps palette_idle->palette (16 entries per frame).",
